# ─────────────────────────────────────────────────────────────────────────────
# X-Mart storefront — environment configuration
#
# Setup:  cp .env.example .env.local
# Verify: npm run doctor
#
# Only variables prefixed NEXT_PUBLIC_ are visible in the browser. Never put a
# secret here — anything in this file ships to the client.
# ─────────────────────────────────────────────────────────────────────────────


# ── Required ─────────────────────────────────────────────────────────────────
# Base URL of your API, including the /api/v1 suffix.
#
# Local:        http://localhost:5000/api/v1
# Production:   https://api.yourstore.com/api/v1
#
# There is no built-in demo fallback: if this is missing, orders and carts
# cannot be saved and the shop will look broken at checkout.
NEXT_PUBLIC_BASE_API=http://localhost:5000/api/v1


# ── Optional ─────────────────────────────────────────────────────────────────
# The storefront's own public origin. Used for absolute URLs in metadata, the
# sitemap and password-reset links. Leave unset to infer it on Vercel; set it
# explicitly everywhere else, e.g. https://yourstore.com
# NEXT_PUBLIC_SITE_URL=https://yourstore.com